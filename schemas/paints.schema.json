{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paintz.local/schemas/paints.schema.json",
  "title": "PaintZ PackKit v1 paint manifest",
  "type": "object",
  "required": ["schema_version", "pack", "paints"],
  "properties": {
    "schema_version": {"const": 1},
    "pack": {
      "type": "object",
      "required": ["prefix", "name"],
      "properties": {
        "prefix": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{1,2}$"},
        "name": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "generator": {
      "type": "object",
      "properties": {
        "pattern_scales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "number", "exclusiveMinimum": 0, "maximum": 10}
        }
      },
      "additionalProperties": true
    },
    "dayz": {
      "type": "object",
      "properties": {
        "emit_config_fragment": {"type": "boolean"},
        "namespace_role": {"enum": ["owner", "satellite"]},
        "addon_root": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "patch_class": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "owner_class": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "owner_patch": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "base_class": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "class_prefix": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "types_nominal": {"type": "integer", "minimum": 0},
        "types_lifetime": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "if": {
            "properties": {"namespace_role": {"const": "satellite"}},
            "required": ["namespace_role"]
          },
          "then": {"required": ["owner_class", "owner_patch"]}
        },
        {
          "if": {
            "properties": {"namespace_role": {"const": "owner"}}
          },
          "then": {"not": {"required": ["owner_patch"]}}
        }
      ],
      "additionalProperties": false
    },
    "paints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9]{2,12}$"},
          "name": {"type": "string", "minLength": 1},
          "type": {"enum": ["basic", "solid", "camo", "pattern", "metallic", "rusted", "weathered", "fluorescent", "special", "custom", "transparent"]},
          "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
          "pattern": {"type": "string", "minLength": 1},
          "appearance_profile": {"type": "string", "minLength": 1},
          "finish": {"type": "string"},
          "badge_text": {"type": "string"},
          "field_text": {"type": "string"},
          "footer_text": {"type": "string"},
          "dayz_class": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
        },
        "oneOf": [
          {"required": ["color"], "not": {"required": ["pattern"]}},
          {"required": ["pattern"], "not": {"required": ["color"]}}
        ],
        "allOf": [
          {
            "if": {"properties": {"type": {"const": "basic"}}, "required": ["type"]},
            "then": {
              "required": ["color"],
              "not": {"anyOf": [{"required": ["pattern"]}, {"required": ["appearance_profile"]}]}
            }
          },
          {
            "if": {"properties": {"type": {"const": "solid"}}, "required": ["type"]},
            "then": {"required": ["color"], "not": {"required": ["pattern"]}}
          },
          {
            "if": {"properties": {"type": {"enum": ["camo", "pattern"]}}, "required": ["type"]},
            "then": {"required": ["pattern"], "not": {"required": ["color"]}}
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
